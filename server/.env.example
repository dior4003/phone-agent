# ---- Majburiy (npm run setup bularni o'zi yaratib beradi) ----
# Telefondagi agent shu token bilan ulanadi (kamida 16 belgi)
AGENT_TOKEN=
# Panelga kirish paroli (kamida 8 belgi)
PANEL_PASSWORD=
# Sessiya (JWT) imzosi uchun maxfiy kalit (kamida 16 belgi)
JWT_SECRET=

# ---- Ixtiyoriy ----
PORT=4000
# Faqat shu kompyuterdan: 127.0.0.1. LAN yoki VPS uchun: 0.0.0.0
HOST=127.0.0.1
# Cloudflare Tunnel / nginx orqasida ishlasangiz true qiling (haqiqiy IP'ni olish uchun)
TRUST_PROXY=false
# Sessiya muddati (soat)
SESSION_HOURS=12
# Telefonga yuborilgan buyruq javobini kutish vaqti (ms)
CMD_TIMEOUT_MS=30000
# git clone / npm install uchun kutish vaqti (ms)
DEPLOY_TIMEOUT_MS=900000

# 2FA (Google Authenticator va shunga o'xshash ilovalar). npm run totp bilan yarating
TOTP_SECRET=

# Telegram ogohlantirishlari (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_TEMP_C=45
ALERT_RAM_MIN_PCT=10
ALERT_BATTERY_MIN=15
ALERT_OFFLINE_SEC=60
